<!-- pages/settings/settings.wxml -->
<view class="page">
  <view class="profile-card">
    <view class="avatar">
      <text class="avatar-text">{{nickname ? nickname[0] : 'H'}}</text>
    </view>
    <view class="profile-info">
      <text class="profile-name">{{nickname || 'helloworld'}}</text>
      <text class="profile-email">{{email || '未设置邮箱'}}</text>
    </view>
  </view>

  <view class="card">
    <view class="card-title">通知设置</view>
    <view class="setting-item">
      <view class="setting-left">
        <text class="setting-label">微信订阅消息</text>
        <text class="setting-desc">通过微信服务通知推送</text>
      </view>
      <switch checked="{{wechatEnabled}}" bindchange="toggleWechat" color="#E8703A" />
    </view>
    <view class="setting-item">
      <view class="setting-left">
        <text class="setting-label">Chrome 桌面通知</text>
        <text class="setting-desc">浏览器推送通知</text>
      </view>
      <switch checked="{{chromeEnabled}}" bindchange="toggleChrome" color="#E8703A" />
    </view>
    <view class="setting-item">
      <view class="setting-left">
        <text class="setting-label">邮件通知</text>
        <text class="setting-desc">发送提醒邮件到绑定邮箱</text>
      </view>
      <switch checked="{{emailEnabled}}" bindchange="toggleEmail" color="#E8703A" />
    </view>
  </view>

  <view class="card">
    <view class="card-title">数据管理</view>
    <view class="setting-item" bindtap="exportData">
      <text class="setting-label">导出数据</text>
      <text class="setting-arrow">›</text>
    </view>
    <view class="setting-item" bindtap="importData">
      <text class="setting-label">导入数据</text>
      <text class="setting-arrow">›</text>
    </view>
  </view>

  <view class="card">
    <view class="setting-item" bindtap="requestSubscribe">
      <text class="setting-label">订阅消息授权</text>
      <text class="setting-arrow">›</text>
    </view>
  </view>
</view>
