/**app.wxss**/
page {
  background-color: #fafafa;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
  color: #1a1a1a;
  font-size: 28rpx;
  line-height: 1.6;
}

/* 全局主题变量 */
.theme-primary { color: #E8703A; }
.theme-success { color: #4CAF50; }
.theme-warning { color: #FF9800; }
.theme-danger { color: #F44336; }

.bg-primary { background-color: #E8703A; }
.bg-page { background-color: #fafafa; }
.bg-card { background-color: #ffffff; }

/* 通用卡片 */
.card {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 24rpx rgba(232, 112, 58, 0.06);
}

/* 状态标签 */
.status-badge {
  display: inline-flex;
  align-items: center;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  font-weight: 500;
}

.status-active { background: #e8f5e9; color: #2e7d32; }
.status-expiring { background: #fff3e0; color: #e65100; }
.status-expired { background: #ffebee; color: #c62828; }
.status-cancelled { background: #f5f5f5; color: #757575; }

/* 按钮 */
.btn-primary {
  background: linear-gradient(135deg, #E8703A, #f09060);
  color: white;
  border-radius: 16rpx;
  padding: 20rpx 40rpx;
  font-size: 30rpx;
  font-weight: 600;
  text-align: center;
  border: none;
}

.btn-primary::after { border: none; }

.btn-outline {
  background: #ffffff;
  color: #E8703A;
  border: 2rpx solid #E8703A;
  border-radius: 16rpx;
  padding: 18rpx 38rpx;
  font-size: 30rpx;
  font-weight: 500;
  text-align: center;
}

.btn-outline::after { border: none; }
