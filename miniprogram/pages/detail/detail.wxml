<!-- pages/detail/detail.wxml -->
<view class="page">
  <view class="detail-header">
    <text class="detail-name">{{subscription.name}}</text>
    <text class="status-badge {{statusClass(subscription.status)}}">{{statusLabel(subscription.status)}}</text>
  </view>

  <view class="card" wx:if="{{subscription.provider}}">
    <text class="detail-label">服务商</text>
    <text class="detail-value">{{subscription.provider}}</text>
  </view>

  <view class="card">
    <text class="detail-label">费用</text>
    <text class="detail-value detail-amount">{{formatCurrency(subscription.amount, subscription.currency)}}/{{cycleLabel(subscription.billing_cycle)}}</text>
  </view>

  <view class="card">
    <view class="detail-row">
      <text class="detail-label">开始日期</text>
      <text class="detail-value">{{subscription.start_date}}</text>
    </view>
    <view class="detail-row" wx:if="{{subscription.expire_date}}">
      <text class="detail-label">到期日期</text>
      <text class="detail-value">{{subscription.expire_date}}</text>
    </view>
    <view class="detail-row" wx:if="{{daysText}}">
      <text class="detail-label">剩余</text>
      <text class="detail-value theme-primary">{{daysText}}</text>
    </view>
  </view>

  <view class="card" wx:if="{{subscription.remark}}">
    <text class="detail-label">备注</text>
    <text class="detail-value">{{subscription.remark}}</text>
  </view>

  <view class="action-bar">
    <button class="btn-outline" bindtap="goEdit">编辑</button>
    <button class="btn-danger" bindtap="handleDelete">删除</button>
  </view>
</view>
