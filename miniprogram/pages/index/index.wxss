/* pages/index/index.wxss */
.page {
  padding: 20rpx 24rpx 120rpx;
}

/* Stats Grid */
.stats-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
  margin-bottom: 28rpx;
}

.stat-card {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 24rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.04);
}

.stat-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.stat-icon-text { font-size: 36rpx; }
.stat-icon.blue { background: #eff6ff; }
.stat-icon.orange { background: #fff7ed; }
.stat-icon.amber { background: #fffbeb; }
.stat-icon.red { background: #fef2f2; }

.stat-info { display: flex; flex-direction: column; }
.stat-value { font-size: 32rpx; font-weight: 700; color: #1a1a1a; }
.stat-label { font-size: 22rpx; color: #999; margin-top: 4rpx; }

/* Quick Actions */
.quick-actions {
  display: flex;
  gap: 16rpx;
  margin-bottom: 28rpx;
}

.action-btn {
  flex: 1;
  background: #ffffff;
  border-radius: 16rpx;
  padding: 20rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}

.action-icon { font-size: 32rpx; }
.action-text { font-size: 26rpx; color: #333; font-weight: 500; }

/* Section */
.section {
  margin-bottom: 24rpx;
}

.section-header {
  margin-bottom: 16rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1a1a1a;
}

/* Timeline */
.timeline-group {
  margin-bottom: 16rpx;
}

.timeline-label {
  font-size: 24rpx;
  color: #999;
  background: #f5f5f5;
  padding: 8rpx 16rpx;
  border-radius: 8rpx;
  margin-bottom: 8rpx;
}

.timeline-empty {
  padding: 16rpx;
}

.empty-text {
  font-size: 24rpx;
  color: #ccc;
}

.timeline-item {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  padding: 20rpx;
  background: #ffffff;
  border-radius: 16rpx;
  margin-bottom: 8rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.03);
}

.timeline-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #E8703A;
  margin-top: 14rpx;
  flex-shrink: 0;
}

.timeline-content {
  flex: 1;
  min-width: 0;
}

.timeline-main {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.timeline-name {
  font-size: 28rpx;
  font-weight: 500;
  color: #1a1a1a;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  flex: 1;
}

.timeline-meta {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 6rpx;
}

.timeline-amount {
  font-size: 24rpx;
  color: #666;
}

.timeline-days {
  font-size: 22rpx;
  color: #E8703A;
}

/* FAB */
.fab {
  position: fixed;
  right: 40rpx;
  bottom: 180rpx;
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #E8703A, #f09060);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 32rpx rgba(232, 112, 58, 0.35);
  z-index: 100;
}

.fab-icon {
  color: white;
  font-size: 48rpx;
  font-weight: 300;
  line-height: 1;
}
