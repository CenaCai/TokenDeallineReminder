<!-- components/product-card/product-card.wxml -->
<view class="product-card {{statusClass}}" bind:tap="onTap" hover-class="product-card--active">
  <!-- 顶部渐变条 -->
  <view class="card-accent-bar {{statusClass}}"></view>

  <!-- 头部：Emoji + 名称 + 状态标签 -->
  <view class="card-header">
    <view class="card-emoji">{{emoji || '📦'}}</view>
    <view class="card-info">
      <view class="card-name">{{name}}</view>
      <view class="card-category">{{categoryLabel}}</view>
    </view>
    <view class="card-status">
      <view class="tag tag-{{statusType}}">{{statusText}}</view>
    </view>
  </view>

  <!-- 额度进度 -->
  <view class="card-quota" wx:if="{{showQuota}}">
    <view class="quota-header">
      <text class="quota-label">剩余额度</text>
      <text class="quota-value">{{remainingPercent}}%</text>
    </view>
    <view class="progress-track progress-{{statusType}}">
      <view class="progress-fill" style="width: {{remainingPercent}}%"></view>
    </view>
    <view class="quota-detail">
      <text>{{quotaUsed}}{{quotaUnit}} / {{quotaTotal}}{{quotaUnit}}</text>
    </view>
  </view>

  <!-- 到期信息 -->
  <view class="card-expire" wx:if="{{expireDate}}">
    <view class="expire-icon">⏰</view>
    <view class="expire-info">
      <text class="expire-label">{{daysLeft >= 0 ? '剩余' : '已过期'}}</text>
      <text class="expire-value {{daysLeft <= 7 ? 'expire-urgent' : ''}}">
        {{daysLeft >= 0 ? daysLeft + '天' : Math.abs(daysLeft) + '天前'}}
      </text>
    </view>
    <view class="expire-date">{{expireDate}}</view>
  </view>

  <!-- 续费价格 -->
  <view class="card-renew" wx:if="{{renewPrice}}">
    <text class="renew-label">续费</text>
    <text class="renew-price">¥{{renewPrice}}<text wx:if="{{renewCycle}}">/{{renewCycle}}</text></text>
  </view>

  <!-- API 同步状态 -->
  <view class="card-sync" wx:if="{{apiProvider}}">
    <text class="sync-icon">🔄</text>
    <text class="sync-text">{{lastSyncTime ? '上次同步: ' + lastSyncTime : '未同步'}}</text>
  </view>
</view>
