/* pages/edit/edit.wxss */
.page { padding: 20rpx; }
.card { background: #fff; border-radius: 20rpx; padding: 28rpx; margin-bottom: 20rpx; box-shadow: 0 4rpx 24rpx rgba(232, 112, 58, 0.06); }
.card-title { font-size: 32rpx; font-weight: 600; color: #2D2420; margin-bottom: 20rpx; }
.form-item { margin-bottom: 24rpx; }
.form-label { font-size: 26rpx; color: #8C7E74; margin-bottom: 8rpx; display: block; }
.form-input, .form-picker { background: #FFF8F0; border-radius: 12rpx; padding: 20rpx; font-size: 28rpx; }
.form-textarea { background: #FFF8F0; border-radius: 12rpx; padding: 20rpx; font-size: 28rpx; width: 100%; height: 160rpx; box-sizing: border-box; }
.btn-area { padding: 20rpx 0; }
.btn-primary { background: linear-gradient(135deg, #E8703A, #f09060); color: #fff; border-radius: 16rpx; font-size: 30rpx; font-weight: 600; margin-bottom: 20rpx; border: none; }
.btn-primary::after { border: none; }
.btn-danger { background: #fff; color: #F44336; border: 2rpx solid #F44336; border-radius: 16rpx; font-size: 30rpx; font-weight: 500; }
.btn-danger::after { border: none; }
