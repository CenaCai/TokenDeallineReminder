/* pages/templates/templates.wxss */
.page { padding: 20rpx 24rpx; }
.search-bar { margin-bottom: 20rpx; }
.search-input { width: 100%; height: 72rpx; padding: 0 24rpx; background: #fff; border-radius: 36rpx; font-size: 26rpx; border: 2rpx solid #eee; }
.group-title { font-size: 24rpx; color: #999; margin: 20rpx 0 12rpx; }
.template-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16rpx; }
.template-card { background: #fff; border-radius: 16rpx; padding: 24rpx; box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04); }
.template-name { font-size: 28rpx; font-weight: 600; color: #1a1a1a; display: block; }
.template-provider { font-size: 22rpx; color: #999; margin-top: 4rpx; display: block; }
.template-price { margin-top: 12rpx; display: flex; align-items: baseline; gap: 4rpx; }
.price-amount { font-size: 32rpx; font-weight: 700; color: #E8703A; }
.price-cycle { font-size: 22rpx; color: #999; }
