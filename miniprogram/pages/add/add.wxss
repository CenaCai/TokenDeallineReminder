/* pages/add/add.wxss */
.page { padding: 20rpx 24rpx 40rpx; }

.card {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.04);
}

.card-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1a1a1a;
  margin-bottom: 20rpx;
}

.form-item { margin-bottom: 20rpx; }
.form-item:last-child { margin-bottom: 0; }

.form-label {
  display: block;
  font-size: 24rpx;
  color: #666;
  margin-bottom: 8rpx;
}

.form-input {
  width: 100%;
  height: 76rpx;
  padding: 0 20rpx;
  border: 2rpx solid #e5e5e5;
  border-radius: 12rpx;
  font-size: 28rpx;
  color: #1a1a1a;
  background: #fafafa;
}

.form-picker {
  height: 76rpx;
  line-height: 76rpx;
  padding: 0 20rpx;
  border: 2rpx solid #e5e5e5;
  border-radius: 12rpx;
  font-size: 28rpx;
  color: #1a1a1a;
  background: #fafafa;
}

.form-row { display: flex; gap: 16rpx; }
.flex-1 { flex: 1; }

.form-textarea {
  width: 100%;
  height: 160rpx;
  padding: 16rpx 20rpx;
  border: 2rpx solid #e5e5e5;
  border-radius: 12rpx;
  font-size: 28rpx;
  color: #1a1a1a;
  background: #fafafa;
}

.checkbox-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.checkbox-text { font-size: 26rpx; color: #333; }

.tag-list {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.tag-item {
  padding: 8rpx 24rpx;
  border-radius: 24rpx;
  font-size: 24rpx;
  background: #f5f5f5;
  color: #666;
  border: 2rpx solid #e5e5e5;
}

.tag-selected {
  background: #fff7ed !important;
  color: #E8703A !important;
  border-color: #E8703A !important;
}

.submit-area {
  padding: 20rpx 0;
}

.btn-primary {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background: linear-gradient(135deg, #E8703A, #f09060);
  color: white;
  border-radius: 16rpx;
  font-size: 30rpx;
  font-weight: 600;
  border: none;
}
