/* components/product-card/product-card.wxss */

.product-card {
  background: var(--card);
  border-radius: var(--radius-lg);
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: var(--card-shadow);
  position: relative;
  overflow: hidden;
  transition: all 0.3s ease;
}

.product-card--active {
  transform: scale(0.98);
  box-shadow: var(--card-shadow-hover);
}

/* 顶部渐变条 */
.card-accent-bar {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 6rpx;
  background: var(--accent-gradient);
  opacity: 0.6;
  transition: opacity 0.3s ease;
}

.card-accent-bar.danger {
  background: linear-gradient(90deg, #F44336, #FF6B6B);
  opacity: 1;
}

.card-accent-bar.warning {
  background: linear-gradient(90deg, #FF9800, #FFB74D);
  opacity: 1;
}

.card-accent-bar.success {
  background: linear-gradient(90deg, #4CAF50, #81C784);
}

/* 头部 */
.card-header {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.card-emoji {
  width: 80rpx;
  height: 80rpx;
  background: var(--bg-secondary);
  border-radius: var(--radius-md);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  flex-shrink: 0;
}

.card-info {
  flex: 1;
  margin-left: 20rpx;
  overflow: hidden;
}

.card-name {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-primary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.card-category {
  font-size: 24rpx;
  color: var(--text-tertiary);
  margin-top: 4rpx;
}

/* 额度进度 */
.card-quota {
  margin: 16rpx 0;
}

.quota-header {
  display: flex;
  justify-content: space-between;
  margin-bottom: 10rpx;
}

.quota-label {
  font-size: 24rpx;
  color: var(--text-secondary);
}

.quota-value {
  font-size: 28rpx;
  font-weight: 700;
}

.quota-detail {
  font-size: 22rpx;
  color: var(--text-tertiary);
  margin-top: 8rpx;
  text-align: right;
}

/* 到期信息 */
.card-expire {
  display: flex;
  align-items: center;
  margin-top: 16rpx;
  padding: 16rpx 20rpx;
  background: var(--bg-secondary);
  border-radius: var(--radius-sm);
}

.expire-icon {
  font-size: 32rpx;
  margin-right: 12rpx;
}

.expire-info {
  flex: 1;
  display: flex;
  align-items: baseline;
  gap: 8rpx;
}

.expire-label {
  font-size: 24rpx;
  color: var(--text-secondary);
}

.expire-value {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.expire-urgent {
  color: var(--danger) !important;
}

.expire-date {
  font-size: 22rpx;
  color: var(--text-tertiary);
}

/* 续费 */
.card-renew {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 12rpx;
  padding-top: 12rpx;
  border-top: 1rpx solid var(--border);
}

.renew-label {
  font-size: 24rpx;
  color: var(--text-tertiary);
}

.renew-price {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--accent);
}

.renew-price text {
  font-size: 22rpx;
  font-weight: 400;
  color: var(--text-tertiary);
}

/* 同步状态 */
.card-sync {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-top: 12rpx;
}

.sync-icon {
  font-size: 24rpx;
}

.sync-text {
  font-size: 22rpx;
  color: var(--text-tertiary);
}
