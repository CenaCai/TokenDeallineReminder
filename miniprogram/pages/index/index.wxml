<!-- pages/index/index.wxml -->
<view class="page">
  <!-- 顶部统计 -->
  <view class="stats-grid">
    <view class="stat-card" wx:for="{{statCards}}" wx:key="label">
      <view class="stat-icon {{item.colorClass}}">
        <text class="stat-icon-text">{{item.emoji}}</text>
      </view>
      <view class="stat-info">
        <text class="stat-value">{{item.value}}</text>
        <text class="stat-label">{{item.label}}</text>
      </view>
    </view>
  </view>

  <!-- 快捷操作 -->
  <view class="quick-actions">
    <view class="action-btn" bindtap="goAdd">
      <text class="action-icon">➕</text>
      <text class="action-text">添加订阅</text>
    </view>
    <view class="action-btn" bindtap="goTemplates">
      <text class="action-icon">📋</text>
      <text class="action-text">模板创建</text>
    </view>
  </view>

  <!-- 到期时间轴 -->
  <view class="section">
    <view class="section-header">
      <text class="section-title">📅 到期时间轴</text>
    </view>

    <view class="timeline-group" wx:for="{{timelineGroups}}" wx:key="key">
      <view class="timeline-label">
        <text>{{item.label}} ({{item.items.length}})</text>
      </view>
      <view wx:if="{{item.items.length === 0}}" class="timeline-empty">
        <text class="empty-text">暂无</text>
      </view>
      <view class="timeline-item" wx:for="{{item.items}}" wx:for-item="sub" wx:key="id" bindtap="goDetail" data-id="{{sub.id}}">
        <view class="timeline-dot"></view>
        <view class="timeline-content">
          <view class="timeline-main">
            <text class="timeline-name">{{sub.name}}</text>
            <text class="status-badge {{statusClass(sub.status)}}">{{statusLabel(sub.status)}}</text>
          </view>
          <view class="timeline-meta">
            <text class="timeline-amount">{{formatCurrency(sub.amount, sub.currency)}}/{{cycleLabel(sub.billing_cycle)}}</text>
            <text class="timeline-days" wx:if="{{sub.daysUntil !== null}}">
              {{sub.daysUntil < 0 ? '已过期' + Math.abs(sub.daysUntil) + '天' : sub.daysUntil === 0 ? '今天到期' : sub.daysUntil + '天后到期'}}
            </text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- 悬浮添加按钮 -->
  <view class="fab" bindtap="goAdd">
    <text class="fab-icon">+</text>
  </view>
</view>
