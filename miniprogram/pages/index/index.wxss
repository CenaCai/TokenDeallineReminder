/* pages/index/index.wxss */

/* 概览卡片 */
.overview-card {
  background: var(--accent-gradient);
  border-radius: var(--radius-xl);
  padding: 36rpx 32rpx;
  margin-bottom: 32rpx;
  color: #FFFFFF;
  position: relative;
  overflow: hidden;
}

.overview-card::after {
  content: '';
  position: absolute;
  top: -40rpx;
  right: -40rpx;
  width: 200rpx;
  height: 200rpx;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 50%;
}

.overview-card::before {
  content: '';
  position: absolute;
  bottom: -60rpx;
  left: -30rpx;
  width: 160rpx;
  height: 160rpx;
  background: rgba(255, 255, 255, 0.06);
  border-radius: 50%;
}

.overview-title {
  font-size: 28rpx;
  opacity: 0.85;
  margin-bottom: 20rpx;
}

.overview-stats {
  display: flex;
  align-items: center;
  justify-content: space-around;
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-value {
  font-size: 48rpx;
  font-weight: 700;
}

.stat-warning {
  color: #FFE082;
}

.stat-danger {
  color: #FF8A80;
}

.stat-label {
  font-size: 22rpx;
  opacity: 0.75;
  margin-top: 4rpx;
}

.stat-divider {
  width: 1rpx;
  height: 60rpx;
  background: rgba(255, 255, 255, 0.2);
}

/* 筛选标签 */
.filter-tabs {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
  overflow-x: auto;
  white-space: nowrap;
  -webkit-overflow-scrolling: touch;
}

.filter-tabs::-webkit-scrollbar {
  display: none;
}

.filter-tab {
  padding: 12rpx 28rpx;
  border-radius: 999rpx;
  font-size: 26rpx;
  color: var(--text-secondary);
  background: var(--card);
  border: 2rpx solid var(--border);
  flex-shrink: 0;
  transition: all 0.3s ease;
}

.filter-tab--active {
  background: var(--accent-light);
  color: var(--accent);
  border-color: var(--accent);
  font-weight: 600;
}

/* 产品列表 */
.product-list {
  padding-bottom: 160rpx;
}

/* 加载 */
.loading-spinner {
  width: 48rpx;
  height: 48rpx;
  border: 4rpx solid var(--border);
  border-top-color: var(--accent);
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
  margin-bottom: 16rpx;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  font-size: 26rpx;
  color: var(--text-tertiary);
}

/* 提醒弹窗 */
.reminder-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 999;
  display: flex;
  align-items: center;
  justify-content: center;
}

.reminder-overlay {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.4);
}

.reminder-content {
  position: relative;
  background: var(--card);
  border-radius: var(--radius-xl);
  padding: 40rpx;
  margin: 0 48rpx;
  width: calc(100% - 96rpx);
  max-width: 600rpx;
  box-shadow: 0 16rpx 64rpx rgba(0, 0, 0, 0.15);
  animation: slideUp 0.3s ease;
}

@keyframes slideUp {
  from { transform: translateY(40rpx); opacity: 0; }
  to { transform: translateY(0); opacity: 1; }
}

.reminder-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 24rpx;
}

.reminder-icon {
  font-size: 40rpx;
}

.reminder-title {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.reminder-list {
  max-height: 400rpx;
  overflow-y: auto;
}

.reminder-item {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  padding: 16rpx 0;
  border-bottom: 1rpx solid var(--border);
}

.reminder-item:last-child {
  border-bottom: none;
}

.reminder-type {
  font-size: 28rpx;
  flex-shrink: 0;
}

.reminder-text {
  font-size: 28rpx;
  color: var(--text-primary);
  line-height: 1.5;
}

.reminder-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 28rpx;
}

.reminder-actions .btn-ghost,
.reminder-actions .btn-primary {
  flex: 1;
}
