<!-- components/empty-state/empty-state.wxml -->
<view class="empty-state">
  <view class="empty-icon">{{icon || '📭'}}</view>
  <view class="empty-title">{{title || '暂无数据'}}</view>
  <view class="empty-desc" wx:if="{{description}}">{{description}}</view>
  <view class="empty-action" wx:if="{{actionText}}">
    <button class="btn-primary" bind:tap="onAction">{{actionText}}</button>
  </view>
</view>
