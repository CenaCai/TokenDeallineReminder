<!-- pages/add/add.wxml -->
<view class="page">
  <!-- 基本信息 -->
  <view class="card">
    <view class="card-title">基本信息</view>
    <view class="form-item">
      <text class="form-label">订阅名称 *</text>
      <input class="form-input" placeholder="如: ChatGPT Plus" value="{{name}}" bindinput="onNameInput" />
    </view>
    <view class="form-row">
      <view class="form-item flex-1">
        <text class="form-label">分类</text>
        <picker range="{{categoryNames}}" value="{{categoryIndex}}" bindchange="onCategoryChange">
          <view class="form-picker">{{categoryNames[categoryIndex] || '选择分类'}}</view>
        </picker>
      </view>
      <view class="form-item flex-1">
        <text class="form-label">服务商</text>
        <input class="form-input" placeholder="OpenAI" value="{{provider}}" bindinput="onProviderInput" />
      </view>
    </view>
  </view>

  <!-- 费用信息 -->
  <view class="card">
    <view class="card-title">费用信息</view>
    <view class="form-row">
      <view class="form-item flex-1">
        <text class="form-label">金额</text>
        <input class="form-input" type="digit" placeholder="0.00" value="{{amount}}" bindinput="onAmountInput" />
      </view>
      <view class="form-item" style="width: 160rpx">
        <text class="form-label">币种</text>
        <picker range="{{currencies}}" range-key="label" value="{{currencyIndex}}" bindchange="onCurrencyChange">
          <view class="form-picker">{{currencies[currencyIndex].label}}</view>
        </picker>
      </view>
      <view class="form-item" style="width: 160rpx">
        <text class="form-label">周期</text>
        <picker range="{{cycles}}" range-key="label" value="{{cycleIndex}}" bindchange="onCycleChange">
          <view class="form-picker">{{cycles[cycleIndex].label}}</view>
        </picker>
      </view>
    </view>
  </view>

  <!-- 时间信息 -->
  <view class="card">
    <view class="card-title">时间信息</view>
    <view class="form-row">
      <view class="form-item flex-1">
        <text class="form-label">开始日期 *</text>
        <picker mode="date" value="{{startDate}}" bindchange="onStartDateChange">
          <view class="form-picker">{{startDate || '选择日期'}}</view>
        </picker>
      </view>
      <view class="form-item flex-1">
        <text class="form-label">到期日期</text>
        <picker mode="date" value="{{expireDate}}" bindchange="onExpireDateChange">
          <view class="form-picker">{{expireDate || '自动计算'}}</view>
        </picker>
      </view>
    </view>
    <view class="form-item">
      <label class="checkbox-row">
        <checkbox checked="{{autoRenew}}" bindtap="toggleAutoRenew" color="#E8703A" />
        <text class="checkbox-text">自动续费</text>
      </label>
    </view>
  </view>

  <!-- 标签 -->
  <view class="card" wx:if="{{tags.length > 0}}">
    <view class="card-title">标签</view>
    <view class="tag-list">
      <view class="tag-item {{item.selected ? 'tag-selected' : ''}}"
            wx:for="{{tags}}" wx:key="id"
            bindtap="toggleTag" data-index="{{index}}"
            style="{{item.selected ? 'background-color:' + item.color + ';color:white' : ''}}">
        {{item.name}}
      </view>
    </view>
  </view>

  <!-- 提醒设置 -->
  <view class="card">
    <view class="card-title">提醒设置</view>
    <view class="form-item">
      <text class="form-label">提醒时机</text>
      <view class="tag-list">
        <view class="tag-item {{item.selected ? 'tag-selected' : ''}}"
              wx:for="{{reminderOptions}}" wx:key="value"
              bindtap="toggleReminderDay" data-index="{{index}}">
          {{item.label}}
        </view>
      </view>
    </view>
    <view class="form-item">
      <text class="form-label">通知渠道</text>
      <view class="tag-list">
        <view class="tag-item {{item.selected ? 'tag-selected' : ''}}"
              wx:for="{{channelOptions}}" wx:key="value"
              bindtap="toggleChannel" data-index="{{index}}">
          {{item.label}}
        </view>
      </view>
    </view>
  </view>

  <!-- 备注 -->
  <view class="card">
    <view class="card-title">备注</view>
    <textarea class="form-textarea" placeholder="添加备注..." value="{{remark}}" bindinput="onRemarkInput" />
  </view>

  <!-- 提交 -->
  <view class="submit-area">
    <button class="btn-primary" bindtap="handleSubmit" disabled="{{submitting}}">
      {{submitting ? '保存中...' : '保存订阅'}}
    </button>
  </view>
</view>
