/* app.wxss - 全局样式 · 温暖卡片风格 */

/* ========== 设计令牌 ========== */
page {
  --bg: #FFF8F0;
  --bg-secondary: #FFF2E6;
  --card: #FFFFFF;
  --card-shadow: 0 4rpx 24rpx rgba(232, 112, 58, 0.08);
  --card-shadow-hover: 0 8rpx 40rpx rgba(232, 112, 58, 0.15);
  --text-primary: #2D2420;
  --text-secondary: #8C7E74;
  --text-tertiary: #B8ADA5;
  --accent: #E8703A;
  --accent-light: #FFF0E8;
  --accent-gradient: linear-gradient(135deg, #E8703A 0%, #F09C5A 100%);
  --success: #4CAF50;
  --success-light: #E8F5E9;
  --warning: #FF9800;
  --warning-light: #FFF3E0;
  --danger: #F44336;
  --danger-light: #FFEBEE;
  --border: #F0E6DE;
  --radius-sm: 16rpx;
  --radius-md: 24rpx;
  --radius-lg: 32rpx;
  --radius-xl: 40rpx;

  background-color: var(--bg);
  color: var(--text-primary);
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Helvetica Neue', sans-serif;
  font-size: 28rpx;
  line-height: 1.6;
  padding-bottom: env(safe-area-inset-bottom);
}

/* ========== 通用布局 ========== */
.container {
  padding: 24rpx 32rpx;
  box-sizing: border-box;
  min-height: 100vh;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 20rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.section-title .icon {
  font-size: 32rpx;
}

/* ========== 卡片 ========== */
.card {
  background: var(--card);
  border-radius: var(--radius-lg);
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: var(--card-shadow);
  transition: all 0.3s ease;
  position: relative;
  overflow: hidden;
}

.card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 6rpx;
  background: var(--accent-gradient);
  opacity: 0;
  transition: opacity 0.3s ease;
}

.card:active {
  transform: scale(0.98);
  box-shadow: var(--card-shadow-hover);
}

.card:active::before {
  opacity: 1;
}

/* ========== 按钮 ========== */
.btn-primary {
  background: var(--accent-gradient);
  color: #FFFFFF;
  border: none;
  border-radius: var(--radius-md);
  padding: 24rpx 48rpx;
  font-size: 30rpx;
  font-weight: 600;
  text-align: center;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  transition: all 0.3s ease;
}

.btn-primary:active {
  opacity: 0.85;
  transform: scale(0.97);
}

.btn-secondary {
  background: var(--accent-light);
  color: var(--accent);
  border: 2rpx solid transparent;
  border-radius: var(--radius-md);
  padding: 20rpx 40rpx;
  font-size: 28rpx;
  font-weight: 500;
  text-align: center;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
}

.btn-secondary:active {
  background: #FFE4D6;
}

.btn-ghost {
  background: transparent;
  color: var(--text-secondary);
  border: 2rpx solid var(--border);
  border-radius: var(--radius-md);
  padding: 20rpx 40rpx;
  font-size: 28rpx;
  text-align: center;
}

.btn-ghost:active {
  background: var(--bg-secondary);
}

.btn-danger {
  background: var(--danger-light);
  color: var(--danger);
  border: none;
  border-radius: var(--radius-md);
  padding: 20rpx 40rpx;
  font-size: 28rpx;
  font-weight: 500;
  text-align: center;
}

.btn-danger:active {
  background: #FFCDD2;
}

/* ========== 表单 ========== */
.form-group {
  margin-bottom: 28rpx;
}

.form-label {
  font-size: 26rpx;
  color: var(--text-secondary);
  margin-bottom: 12rpx;
  display: block;
}

.form-input {
  background: var(--bg);
  border: 2rpx solid var(--border);
  border-radius: var(--radius-md);
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  color: var(--text-primary);
  width: 100%;
  box-sizing: border-box;
  transition: border-color 0.3s ease;
}

.form-input:focus {
  border-color: var(--accent);
  background: #FFFFFF;
}

.form-textarea {
  min-height: 160rpx;
}

/* ========== 标签 ========== */
.tag {
  display: inline-flex;
  align-items: center;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 500;
}

.tag-danger {
  background: var(--danger-light);
  color: var(--danger);
}

.tag-warning {
  background: var(--warning-light);
  color: var(--warning);
}

.tag-success {
  background: var(--success-light);
  color: var(--success);
}

.tag-info {
  background: var(--accent-light);
  color: var(--accent);
}

/* ========== 分隔线 ========== */
.divider {
  height: 1rpx;
  background: var(--border);
  margin: 24rpx 0;
}

/* ========== 空状态 ========== */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 40rpx;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 24rpx;
}

.empty-text {
  font-size: 30rpx;
  color: var(--text-tertiary);
  margin-bottom: 32rpx;
}

/* ========== 加载 ========== */
.loading-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx;
}

/* ========== 安全区域 ========== */
.safe-bottom {
  padding-bottom: calc(env(safe-area-inset-bottom) + 24rpx);
}

/* ========== FAB ========== */
.fab {
  position: fixed;
  right: 40rpx;
  bottom: calc(env(safe-area-inset-bottom) + 120rpx);
  width: 112rpx;
  height: 112rpx;
  background: var(--accent-gradient);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 32rpx rgba(232, 112, 58, 0.35);
  z-index: 100;
  transition: all 0.3s ease;
}

.fab:active {
  transform: scale(0.9);
  box-shadow: 0 4rpx 16rpx rgba(232, 112, 58, 0.4);
}

.fab-icon {
  font-size: 56rpx;
  color: #FFFFFF;
  font-weight: 300;
}

/* ========== 模式切换 ========== */
.mode-tabs {
  display: flex;
  gap: 12rpx;
  margin-bottom: 32rpx;
  background: var(--bg-secondary);
  border-radius: var(--radius-md);
  padding: 6rpx;
}

.mode-tab {
  flex: 1;
  text-align: center;
  padding: 16rpx 8rpx;
  border-radius: var(--radius-sm);
  font-size: 26rpx;
  color: var(--text-secondary);
  transition: all 0.3s ease;
}

.mode-tab.active {
  background: var(--card);
  color: var(--accent);
  font-weight: 600;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

/* ========== 进度条 ========== */
.progress-track {
  height: 16rpx;
  background: var(--bg-secondary);
  border-radius: 999rpx;
  overflow: hidden;
  position: relative;
}

.progress-fill {
  height: 100%;
  border-radius: 999rpx;
  transition: width 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  position: relative;
}

.progress-fill::after {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(90deg, transparent 0%, rgba(255,255,255,0.3) 50%, transparent 100%);
  animation: shimmer 2s infinite;
}

@keyframes shimmer {
  0% { transform: translateX(-100%); }
  100% { transform: translateX(100%); }
}

.progress-danger .progress-fill {
  background: linear-gradient(90deg, #F44336, #FF6B6B);
}

.progress-warning .progress-fill {
  background: linear-gradient(90deg, #FF9800, #FFB74D);
}

.progress-success .progress-fill {
  background: linear-gradient(90deg, #4CAF50, #81C784);
}

/* ========== Toast ========== */
.toast-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(0, 0, 0, 0.3);
}

.toast-box {
  background: var(--card);
  border-radius: var(--radius-lg);
  padding: 48rpx;
  margin: 0 80rpx;
  text-align: center;
  box-shadow: 0 16rpx 64rpx rgba(0, 0, 0, 0.12);
  animation: toastIn 0.3s ease;
}

@keyframes toastIn {
  from { transform: scale(0.8); opacity: 0; }
  to { transform: scale(1); opacity: 1; }
}
