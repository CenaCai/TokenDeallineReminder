/* pages/detail/detail.wxss */
.page { padding: 20rpx 24rpx; }
.detail-header { display: flex; align-items: center; gap: 16rpx; margin-bottom: 24rpx; }
.detail-name { font-size: 36rpx; font-weight: 700; color: #1a1a1a; }
.card { background: #fff; border-radius: 20rpx; padding: 28rpx; margin-bottom: 16rpx; box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.04); }
.detail-row { display: flex; justify-content: space-between; align-items: center; padding: 8rpx 0; }
.detail-label { font-size: 24rpx; color: #999; }
.detail-value { font-size: 28rpx; color: #1a1a1a; font-weight: 500; }
.detail-amount { font-size: 32rpx; color: #E8703A; font-weight: 700; }
.action-bar { display: flex; gap: 16rpx; margin-top: 32rpx; }
.btn-outline { flex: 1; height: 80rpx; line-height: 80rpx; border: 2rpx solid #E8703A; color: #E8703A; border-radius: 16rpx; font-size: 28rpx; background: #fff; }
.btn-danger { flex: 1; height: 80rpx; line-height: 80rpx; background: #fee2e2; color: #dc2626; border-radius: 16rpx; font-size: 28rpx; border: none; }
