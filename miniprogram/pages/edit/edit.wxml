<!-- pages/edit/edit.wxml -->
<view class="page">
  <view class="card">
    <view class="card-title">编辑订阅</view>
    <view class="form-item">
      <text class="form-label">订阅名称 *</text>
      <input class="form-input" placeholder="如: ChatGPT Plus" value="{{name}}" bindinput="onNameInput" />
    </view>
    <view class="form-item">
      <text class="form-label">服务商</text>
      <input class="form-input" placeholder="OpenAI" value="{{provider}}" bindinput="onProviderInput" />
    </view>
    <view class="form-item">
      <text class="form-label">到期日期 *</text>
      <picker mode="date" value="{{expireDate}}" bindchange="onExpireDateChange">
        <view class="form-picker">{{expireDate || '选择到期日期'}}</view>
      </picker>
    </view>
    <view class="form-item">
      <text class="form-label">备注</text>
      <textarea class="form-textarea" placeholder="添加备注..." value="{{remark}}" bindinput="onRemarkInput" />
    </view>
  </view>
  <view class="btn-area">
    <button class="btn-primary" bindtap="onSave">保存修改</button>
    <button class="btn-danger" bindtap="onDelete">删除订阅</button>
  </view>
</view>
