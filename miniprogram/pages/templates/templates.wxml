<!-- pages/templates/templates.wxml -->
<view class="page">
  <view class="search-bar">
    <input class="search-input" placeholder="搜索模板..." value="{{search}}" bindinput="onSearch" />
  </view>

  <view wx:for="{{groupedTemplates}}" wx:key="category" wx:for-item="group">
    <view class="group-title">{{group.category}}</view>
    <view class="template-grid">
      <view class="template-card" wx:for="{{group.items}}" wx:for-item="t" wx:key="id" bindtap="useTemplate" data-template="{{t}}">
        <text class="template-name">{{t.name}}</text>
        <text class="template-provider">{{t.provider || t.category}}</text>
        <view class="template-price">
          <text class="price-amount">{{formatCurrency(t.amount, t.currency)}}</text>
          <text class="price-cycle">/{{cycleLabel(t.billing_cycle)}}</text>
        </view>
      </view>
    </view>
  </view>
</view>
