/* components/emoji-picker/emoji-picker.wxss */
.emoji-picker {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 999;
}

.emoji-overlay {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.4);
}

.emoji-panel {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  background: var(--card);
  border-radius: var(--radius-xl) var(--radius-xl) 0 0;
  padding: 32rpx;
  padding-bottom: calc(env(safe-area-inset-bottom) + 32rpx);
  animation: slideUp 0.3s ease;
}

@keyframes slideUp {
  from { transform: translateY(100%); }
  to { transform: translateY(0); }
}

.emoji-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.emoji-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.emoji-close {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: var(--text-tertiary);
  background: var(--bg-secondary);
  border-radius: 50%;
}

.emoji-grid {
  display: grid;
  grid-template-columns: repeat(8, 1fr);
  gap: 12rpx;
  max-height: 400rpx;
  overflow-y: auto;
}

.emoji-item {
  aspect-ratio: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  border-radius: var(--radius-sm);
  background: var(--bg-secondary);
  transition: all 0.2s ease;
}

.emoji-item:active {
  transform: scale(0.85);
  background: var(--accent-light);
}

.emoji-item--active {
  background: var(--accent-light);
  box-shadow: 0 0 0 4rpx var(--accent);
}

.emoji-preview {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  margin-top: 24rpx;
  padding: 16rpx;
  background: var(--bg-secondary);
  border-radius: var(--radius-md);
}

.preview-emoji {
  font-size: 48rpx;
}

.preview-text {
  font-size: 26rpx;
  color: var(--text-secondary);
}
